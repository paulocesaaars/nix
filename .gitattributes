# Wrappers da CLI: o script Unix precisa de LF para o shebang funcionar.
bin/nix text eol=lf
bin/nix.cmd text eol=crlf
bin/env.sh text eol=lf
bin/env.cmd text eol=crlf
bin/env.ps1 text eol=lf
install.sh text eol=lf
install.ps1 text eol=lf
uninstall.sh text eol=lf
uninstall.ps1 text eol=lf

