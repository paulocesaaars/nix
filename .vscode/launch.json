{
  // Selecione o interpretador do .venv (Python: Select Interpreter) se o debug não achar o Python.
  "version": "0.2.0",
  "inputs": [
    {
      "id": "wikiPath",
      "type": "promptString",
      "description": "Caminho da wiki (use barras /)",
      "default": "C:/Notas/MinhaWiki"
    }
  ],
  "configurations": [
    {
      "name": "Nix: init",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "nix",
      "args": ["init"],
      "pythonArgs": ["-P"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Nix: init (--wiki)",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "nix",
      "args": ["init", "--wiki", "${input:wikiPath}"],
      "pythonArgs": ["-P"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Nix: doctor",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "nix",
      "args": ["doctor"],
      "pythonArgs": ["-P"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Nix: sync",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "nix",
      "args": ["sync"],
      "pythonArgs": ["-P"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Nix: status",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "nix",
      "args": ["status"],
      "pythonArgs": ["-P"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Nix: interface (nix ui)",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "nix",
      "args": ["ui"],
      "pythonArgs": ["-P"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Nix: interface (--no-browser, porta 8765)",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "nix",
      "args": ["ui", "--no-browser", "--port", "8765"],
      "pythonArgs": ["-P"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Nix: servidor MCP (stdio)",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "nix",
      "pythonArgs": ["-P"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Nix: testes",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "pytest",
      "args": ["-m", "not slow"],
      "pythonArgs": ["-P"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
